<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  Polkit action for "Open as Administrator": Fileflux starts itself through
  pkexec as root, in a separate window, on one folder.

  The exec.path annotation must be the absolute path of the installed
  fileflux launcher; the default is for a distribution package and the Nix
  package replaces it with its store path at build time. exec.allow_gui
  lets pkexec keep DISPLAY and XAUTHORITY so the window can open. Without
  this file Fileflux still works through `pkexec env DISPLAY=... `, with
  polkit's generic prompt.
-->
<policyconfig>
  <vendor>Fileflux</vendor>
  <vendor_url>https://github.com/0xErwin1/fileflux</vendor_url>

  <action id="dev.fileflux.open-as-admin">
    <description>Open Fileflux as administrator</description>
    <message>Authentication is required to open Fileflux as administrator</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/fileflux</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
